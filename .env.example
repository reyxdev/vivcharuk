# Local development. start.sh copies this to .env on first run and fills every __…__ with a fresh
# random value; nothing here is a real secret. Never reuse these values on a live server.
NODE_ENV=development
DATABASE_URL=postgresql://vivcharyk:__DB_PASSWORD__@127.0.0.1:5434/vivcharyk
DATABASE_DIRECT_URL=postgresql://vivcharyk:__DB_PASSWORD__@127.0.0.1:5434/vivcharyk
JWT_ACCESS_SECRET=__HEX32__
COOKIE_SECRET=__HEX32__
STAFF_TOKEN_SECRET=__HEX32__
MFA_ENCRYPTION_KEY=__B64KEY__
SITE_URL=http://127.0.0.1:5173
# Languages the site serves (round 24 G093: Ukrainian and English at launch). Read by the site build
# (Vite, from this root .env) and by the API (feeds, sitemap alternates, IndexNow). uk is always on.
VITE_ENABLED_LOCALES=uk,en
# Development stand-ins: test payment and a 1 ₴ delivery tariff.
SHIPPING_TEST_RATES=1
PAYMENTS_STUB=1

# Filled in later (empty = off): see README.md, «Заглушки».
NOVA_POSHTA_API_KEY=
CLOUDINARY_URL=
TELEGRAM_BOT_TOKEN=

# Site mail through Resend (round 18 C15) and «Пошта» in the panel reading info@ (round 19 D1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
MAILBOX_ADDRESS=info@vivcharuk.com
MAILBOX_PASSWORD=

# Round 24 (empty = off): security.txt contact (the developer's address; else info@), IndexNow key
# (8–128 letters/digits/dashes; pings only with NODE_ENV=production).
SECURITY_CONTACT=
INDEXNOW_KEY=

# Hours on Google Maps (2026-10-03, empty = off): the OAuth client (Web) from the owner's Google Cloud
# project. Redirect URI: ${SITE_URL}/api/v1/admin/google-business/oauth/callback (shown in the panel).
GOOGLE_BP_CLIENT_ID=
GOOGLE_BP_CLIENT_SECRET=
